<?xml version="1.0" encoding="utf-8" ?>
<odoo>

        <!-- Group Member Confirmation Wizard Form View -->
        <record id="view_group_member_confirmation_wizard_form" model="ir.ui.view">
            <field name="name">g2p.group.member.confirmation.wizard.form</field>
            <field name="model">g2p.group.member.confirmation.wizard</field>
            <field name="arch" type="xml">
                <form string="Group Member Status Update Confirmation">
                    <sheet>
                        <group>
                            <field name="change_request_id" invisible="1" />
                            <field name="action_type" invisible="1" />

                            <field name="confirmation_message" widget="text" readonly="1" />

                            <field name="member_count" readonly="1" />

                            <field
                            name="member_names"
                            widget="text"
                            readonly="1"
                            invisible="member_count == 0"
                        />
                        </group>
                    </sheet>
                    <footer>
                        <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        invisible="member_count == 0"
                    />
                        <button name="action_cancel" string="Cancel" type="object" class="btn-secondary" />
                    </footer>
                </form>
            </field>
        </record>

        <!-- Group Member Confirmation Wizard Action -->
        <record id="action_group_member_confirmation_wizard" model="ir.actions.act_window">
            <field name="name">Group Member Status Update</field>
            <field name="res_model">g2p.group.member.confirmation.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{}</field>
        </record>
</odoo>
