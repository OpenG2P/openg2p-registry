                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Active Change Request</span>
                    </div>
                </button>
            </xpath>

            <!-- Add active change request flag at the top of the sheet -->
            <xpath expr="//sheet" position="inside">
