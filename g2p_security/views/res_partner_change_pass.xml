<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_partner_change_password" model="ir.actions.server">
        <field name="name">Change Password</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="binding_model_id" ref="base.model_res_partner" />
        <field name="binding_type">action</field>
        <field name="state">code</field>
        <field name="code">action = records.action_change_password()</field>
        <field
            name="groups_id"
            eval="[
            (4, ref('g2p_registry_base.group_g2p_admin')),
            (4, ref('g2p_registry_base.group_g2p_registrar'))
        ]"
        />
    </record>
</odoo>
