<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_restrict_debug_mode" model="res.groups">
        <field name="name">Restrict Debug Mode</field>
    </record>

    <record id="res_users_pass_history_rule_admin_registrar" model="ir.rule">
        <field name="name">Password History Create - G2P Admin and Registrar</field>
        <field name="model_id" ref="password_security.model_res_users_pass_history" />
        <field
            name="groups"
            eval="[
            (4, ref('g2p_registry_base.group_g2p_admin')),
            (4, ref('g2p_registry_base.group_g2p_registrar'))
        ]"
        />
        <field name="perm_create" eval="1" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_unlink" eval="0" />
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
