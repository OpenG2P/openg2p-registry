<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_module_filter_inherit_g2p" model="ir.ui.view">
        <field name="name">ir.module.module.search.g2p.only</field>
        <field name="model">ir.module.module</field>
        <field name="inherit_id" ref="base.view_module_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='app']" position="attributes">
                <attribute
                    name="domain"
                >[('application', '=', True), ('category_id.name', '=', 'G2P')]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
