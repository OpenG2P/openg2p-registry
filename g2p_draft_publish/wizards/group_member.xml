<odoo>
    <record id="view_draft_group_add_members_wizard" model="ir.ui.view">
        <field name="name">draft.group.add.members.wizard.form</field>
        <field name="model">draft.group.add.members.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Group Members">
                <sheet>
                    <field name="group_id" invisible="1" />
                    <group col="4" colspan="4">
                        <field name="line_ids" nolabel="1" colspan="4">
                            <tree editable="bottom" default_order="name asc">
                                <field name="member_id" string="Member" />
                                <field name="gender" string="Gender" />
                                <field name="phone" string="Phone" />
                                <field name="region" string="Region" />
                            </tree>
                        </field>
                    </group>
                    <footer>
                        <button string="Save" type="object" name="action_save_members" class="btn-primary" />
                        <button string="Cancel" class="btn-secondary" special="cancel" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_draft_group_view_members_wizard" model="ir.ui.view">
        <field name="name">draft.group.view.members.wizard.form</field>
        <field name="model">draft.group.add.members.wizard</field>
        <field name="arch" type="xml">
            <form string="Group Members">
                <sheet>
                    <field name="group_id" invisible="1" />
                    <group col="4" colspan="4">
                        <field name="line_ids" nolabel="1" colspan="4">
                            <tree create="false" delete="false" edit="false">
                                <field name="member_id" />
                                <field name="gender" />
                                <field name="phone" />
                                <field name="region" />
                            </tree>
                        </field>
                    </group>
                    <footer>
                        <button string="Close" class="btn-secondary" special="cancel" />
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_draft_group_view_members_wizard" model="ir.actions.act_window">
        <field name="name">View Group Members</field>
        <field name="res_model">draft.group.add.members.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_draft_group_view_members_wizard" />
        <field name="target">new</field>
        <field name="context">{'default_group_id': active_id}</field>
    </record>

    <record id="action_draft_group_add_members_wizard" model="ir.actions.act_window">
        <field name="name">Add Group Members</field>
        <field name="res_model">draft.group.add.members.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_draft_group_add_members_wizard" />
        <field name="target">new</field>
    </record>
</odoo>
